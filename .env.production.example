# MaliScope production environment — copy to .env on the VM and fill in.
# Never commit the real .env.

# --- Postgres (used by both the postgres service and DATABASE_URL in compose) ---
PGUSER=maliscope
PGPASSWORD=CHANGE_ME_to_a_long_random_string
PGDATABASE=maliscope
# PGHOST / PGPORT are set inside the container automatically; leave these for
# app code that reads individual vars.
PGHOST=postgres
PGPORT=5432

# --- Next.js runtime ---
NODE_ENV=production
# NEXT_PUBLIC_* env vars are baked in at build time, not runtime.
