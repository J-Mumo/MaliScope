PGUSER=maliscope
PGPASSWORD=maliscope
PGHOST=localhost
PGPORT=5433
PGDATABASE=maliscope
DATABASE_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Optional discovery email alerts via Resend. If unset, discovery still runs
# and high-quality alerts remain queued until email is configured.
RESEND_API_KEY=
DISCOVERY_ALERT_EMAIL=
DISCOVERY_ALERT_FROM=MaliScope <alerts@example.com>
